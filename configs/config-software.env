#!/usr/bin/env bash
# ==============================================================================
# ArchGuard USB Builder - Software Configuration
# config-files/config-software.env
# ==============================================================================
#
# Defines the packages installed by ArchGuard.
#
# Hardware-dependent CPU and GPU packages are selected separately
# after hardware detection.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Installation options
# ------------------------------------------------------------------------------

SOFTWARE_ENABLE_PLASMA="true"
SOFTWARE_ENABLE_KVM="true"


# ------------------------------------------------------------------------------
# ArchGuard Base
# Mandatory packages for a secure, bootable terminal system.
# ------------------------------------------------------------------------------

ARCHGUARD_BASE=(
    # Base system
    base
    base-devel
    linux
    linux-headers
    linux-firmware

    # Encryption and TPM
    cryptsetup
    lvm2
    tpm2-tss
    tpm2-tools

    # Initramfs and boot security
    mkinitcpio
    sbctl
    sbsigntools
    efibootmgr

    # Security
    apparmor
    nftables
    libpwquality
    inotify-tools

    # Networking
    networkmanager
    iwd
    iproute2
    iputils

    # Filesystems
    e2fsprogs
    dosfstools

    # System utilities
    reflector
    sudo
    man-db
    git
    neovim
    tar
    gzip
    unzip
    7zip
    binutils

    # Boot splash
    plymouth
)


# ------------------------------------------------------------------------------
# System Support
# Common hardware, audio, fonts and desktop integration.
# ------------------------------------------------------------------------------

SYSTEM_SUPPORT=(
    # Bluetooth
    bluez
    bluez-utils

    # Audio
    pipewire
    pipewire-audio
    pipewire-alsa
    pipewire-pulse
    wireplumber

    # Multimedia framework
    gstreamer
    gst-plugins-base
    gst-plugins-good

    # Device management
    udisks2
    polkit

    # Fonts
    noto-fonts
    noto-fonts-cjk
    noto-fonts-emoji
)


# ------------------------------------------------------------------------------
# KDE Plasma
# Plasma desktop and selected applications.
# ------------------------------------------------------------------------------

PLASMA=(
    # KDE Plasma desktop
    plasma-meta

    # Selected applications
    dolphin
    firefox
    haruna
    keepassxc
)


# ------------------------------------------------------------------------------
# KVM / QEMU
# Installed only when SOFTWARE_ENABLE_KVM is true.
# ------------------------------------------------------------------------------

KVM_PACKAGES=(
    qemu-desktop
    libvirt
    virt-manager
    edk2-ovmf
    dnsmasq
    iptables-nft
    swtpm
)


# ------------------------------------------------------------------------------
# Extra applications
# Intentionally empty. Add optional applications here later.
# ------------------------------------------------------------------------------

EXTRA_PACKAGES=()

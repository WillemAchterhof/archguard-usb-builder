#!/usr/bin/env bash

# ==============================================================================
# ArchGuard USB Builder - Btrfs Configuration
# ==============================================================================
# configs/config-btrfs.env
#
# Default Btrfs configuration.
# Loaded when Btrfs is selected as the root filesystem.
# ==============================================================================

declare -gA BASE_ENV_BTRFS=(
    [LAYOUT]="default"
    [COMPRESSION]="zstd"
    [SNAPSHOTS]="true"
    [COW]="true"
)

declare -ga BASE_ENV_BTRFS_VOLUMES=(
    "@"
    "@home"
    "@var"
    "@log"
    "@cache"
    "@tmp"
)

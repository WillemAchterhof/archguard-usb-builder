#!/usr/bin/env bash

# ==============================================================================
# ArchGuard USB Builder - Base Configuration
# ==============================================================================
# configs/config-base.env

# Root filesystem: btrfs or ext4
BASE_ENV_FILESYSTEM="btrfs"

# EFI partition size (fixed)
BASE_ENV_EFI_SIZE="500M"

# LVM on LUKS is mandatory
BASE_ENV_LUKS="true"

# Swap configuration:
#   half     = Half of available RAM
#   full     = Equal to available RAM (hibernation)
#   disabled = No swap
BASE_ENV_SWAP_ENABLED="full"

# Calculated later from detected hardware
BASE_ENV_SWAP_SIZE=""

# Hostname
BASE_ENV_HOSTNAME="archguard"

# Installation username
BASE_ENV_USERNAME="willem"

# Locale
BASE_ENV_LOCALE="en_US.UTF-8"

# Timezone
BASE_ENV_TIMEZONE="Europe/Amsterdam"

# Keyboard layout
BASE_ENV_KEYBOARD="us"

# Countries used for mirror selection
BASE_ENV_MIRROR_COUNTRIES="Netherlands,Germany"

# Number of parallel package downloads
BASE_ENV_PACMAN_PARALLEL="10"
